#!/bin/sh

protected_branch='refs/heads/docs/ideation'
blocked=0

while read -r _ _ remote_ref _; do
    if [ "$remote_ref" = "$protected_branch" ]; then
        printf '%s\n' "Push blocked: updates and deletion of $protected_branch must go through a pull request." >&2
        blocked=1
    fi
done

exit "$blocked"
